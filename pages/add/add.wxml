<view class="page">
  <view class="form-title">{{isEditing ? '编辑衣物' : '添加衣物'}}</view>

  <view class="upload card" bindtap="chooseImage" aria-label="添加衣物图片，可选">
    <image wx:if="{{form.imageUrl}}" class="upload-image" src="{{form.imageUrl}}" mode="aspectFill" binderror="onImageError" />
    <button wx:if="{{form.imageUrl}}" class="remove-image" catchtap="removeImage">移除</button>
    <view wx:else class="upload-empty">
      <view class="upload-plus">+</view>
      <view class="muted">添加衣物图片（可选）</view>
    </view>
  </view>
  <view class="form section">
    <view class="field">
      <text class="label">名字 <text class="required">*</text></text>
      <input class="input {{errors.name ? 'has-error' : ''}}" placeholder="例如：碎花吊带裙" value="{{form.name}}" data-field="name" bindinput="onInput" maxlength="24" />
      <view wx:if="{{errors.name}}" class="error-text">{{errors.name}}</view>
    </view>

    <view class="field">
      <text class="label">种类 <text class="required">*</text></text>
      <view class="picker-value category-trigger {{errors.category ? 'has-error' : ''}}" bindtap="openCategoryPanel" aria-label="选择衣物分类">
        <text>{{form.category || '选择种类'}}</text>
        <text class="trigger-arrow">›</text>
      </view>
      <view wx:if="{{errors.category}}" class="error-text">{{errors.category}}</view>
    </view>

    <view class="field">
      <text class="label">价格</text>
      <input class="input {{errors.price ? 'has-error' : ''}}" type="digit" placeholder="购买价格，单位元" value="{{form.price}}" data-field="price" bindinput="onInput" />
      <view wx:if="{{errors.price}}" class="error-text">{{errors.price}}</view>
    </view>

    <view class="field">
      <text class="label">颜色</text>
      <input class="input" placeholder="例如：奶油白、雾霾蓝、酒红" value="{{form.color}}" data-field="color" bindinput="onInput" maxlength="16" />
    </view>

    <view class="field">
      <text class="label">季节</text>
      <view class="chip-row">
        <button
          wx:for="{{seasonOptions}}"
          wx:key="name"
          class="chip {{item.selected ? 'active' : ''}}"
          data-season="{{item.name}}"
          bindtap="toggleSeason"
        >
          {{item.name}}
        </button>
      </view>
    </view>

    <view class="field">
      <text class="label">场合标签</text>
      <view class="chip-row wrap">
        <view
          wx:for="{{visibleOccasionOptions}}"
          wx:key="name"
          class="chip occasion-chip {{item.selected ? 'active' : ''}}"
          role="button"
          aria-label="{{item.selected ? '取消选择' : '选择'}}场合{{item.name}}"
          data-occasion="{{item.name}}"
          bindtap="toggleOccasion"
        >
          {{item.name}}
        </view>
      </view>
      <button wx:if="{{hiddenOccasionOptionCount}}" class="occasion-toggle" bindtap="toggleOccasionOptions">{{occasionOptionToggleText}}</button>
      <view class="custom-category compact">
        <input class="custom-input" placeholder="添加自定义场合" value="{{customOccasion}}" bindinput="onCustomOccasionInput" maxlength="10" />
        <button class="custom-button" bindtap="addCustomOccasion">添加场合</button>
      </view>
      <button class="manage-occasion-button" bindtap="openOccasionPanel">管理场合</button>
    </view>

    <view class="field">
      <text class="label">购买时间</text>
      <view class="picker-value category-trigger" bindtap="openDatePanel" aria-label="选择购买日期">
        <text>{{form.purchaseDate || '选择日期'}}</text>
        <text class="trigger-arrow">›</text>
      </view>
    </view>

    <view class="field">
      <text class="label">状态</text>
      <view class="picker-value category-trigger" bindtap="openStatusPanel" aria-label="选择衣物状态">
        <text>{{form.status || '选择状态'}}</text>
        <text class="trigger-arrow">›</text>
      </view>
    </view>

    <view class="field">
      <text class="label">备注</text>
      <textarea class="textarea" placeholder="尺码、品牌、购买渠道、搭配想法" value="{{form.note}}" data-field="note" bindinput="onInput" />
    </view>
  </view>

  <view class="button-stack">
    <button class="primary-button" loading="{{isSaving}}" disabled="{{isSaving}}" bindtap="saveItem">保存</button>
    <button wx:if="{{!isEditing}}" class="ghost-button" loading="{{isSaving}}" disabled="{{isSaving}}" data-continue="true" bindtap="saveItem">保存并继续添加</button>
  </view>

  <view wx:if="{{showCategoryPanel}}" class="panel-mask" catchtap="closeCategoryPanel">
    <view class="category-panel" catchtap="noop">
      <view class="panel-head">
        <view class="panel-actions">
          <button class="panel-action" bindtap="toggleCategoryEditing">{{isCategoryEditing ? '完成' : '编辑'}}</button>
          <button class="panel-close" bindtap="closeCategoryPanel">关闭</button>
        </view>
      </view>

      <view wx:if="{{!isCategoryEditing}}" class="category-grid">
        <view
          wx:for="{{categoryPanelItems}}"
          wx:key="name"
          class="category-chip {{item.selected ? 'selected' : ''}}"
          data-category="{{item.name}}"
          bindtap="selectCategoryFromPanel"
          bindlongpress="startCategoryEditing"
          aria-label="选择分类{{item.name}}"
        >
          {{item.name}}
        </view>
      </view>

      <view wx:else class="category-edit-list">
        <view wx:for="{{categoryPanelItems}}" wx:key="name" class="category-edit-card">
          <button class="delete-x" data-category="{{item.name}}" catchtap="deleteCustomCategory">×</button>
          <input
            class="category-edit-input"
            value="{{item.draftName}}"
            data-index="{{index}}"
            bindinput="onCategoryDraftInput"
            maxlength="10"
          />
          <view class="category-card-actions">
            <button class="mini-button save-mini" data-index="{{index}}" bindtap="renameCategoryFromPanel">保存</button>
            <button class="mini-button" disabled="{{!item.canMoveUp}}" data-category="{{item.name}}" data-direction="-1" bindtap="moveCategoryFromPanel">上移</button>
            <button class="mini-button" disabled="{{!item.canMoveDown}}" data-category="{{item.name}}" data-direction="1" bindtap="moveCategoryFromPanel">下移</button>
          </view>
        </view>
      </view>

      <view class="panel-add">
        <input class="custom-input" placeholder="没有合适的？输入新种类" value="{{customCategory}}" bindinput="onCustomCategoryInput" maxlength="10" />
        <button class="custom-button" bindtap="addCustomCategory">添加</button>
      </view>
    </view>
  </view>

  <!-- 场合管理面板 -->
  <view wx:if="{{showOccasionPanel}}" class="panel-mask" catchtap="closeOccasionPanel">
    <view class="category-panel" catchtap="noop">
      <view class="panel-head">
        <view class="panel-actions" style="grid-template-columns: 1fr;">
          <button class="panel-close" bindtap="closeOccasionPanel">完成</button>
        </view>
      </view>

      <view class="category-edit-list">
        <view wx:for="{{occasionPanelItems}}" wx:key="name" class="category-edit-card">
          <button class="delete-x" data-occasion="{{item.name}}" catchtap="deleteCustomOccasion">×</button>
          <input
            class="category-edit-input"
            value="{{item.draftName}}"
            data-index="{{index}}"
            bindinput="onOccasionDraftInput"
            maxlength="10"
          />
          <view class="category-card-actions">
            <button class="mini-button save-mini" data-index="{{index}}" bindtap="renameOccasionFromPanel">保存</button>
            <button class="mini-button" disabled="{{!item.canMoveUp}}" data-occasion="{{item.name}}" data-direction="-1" bindtap="moveOccasionFromPanel">上移</button>
            <button class="mini-button" disabled="{{!item.canMoveDown}}" data-occasion="{{item.name}}" data-direction="1" bindtap="moveOccasionFromPanel">下移</button>
          </view>
        </view>
      </view>

      <view class="panel-add">
        <input class="custom-input" placeholder="输入新场合" value="{{customOccasion}}" bindinput="onCustomOccasionInput" maxlength="10" />
        <button class="custom-button" bindtap="addCustomOccasion">添加</button>
      </view>
    </view>
  </view>

  <!-- 状态面板（简单选择，无编辑） -->
  <view wx:if="{{showStatusPanel}}" class="panel-mask" catchtap="closeStatusPanel">
    <view class="category-panel" catchtap="noop">
      <view class="panel-head">
        <view class="panel-actions">
          <button class="panel-close" bindtap="closeStatusPanel">关闭</button>
        </view>
      </view>
      <view class="category-grid">
        <view
          wx:for="{{statuses}}"
          wx:key="*this"
          class="category-chip {{item === form.status ? 'selected' : ''}}"
          data-status="{{item}}"
          bindtap="selectStatus"
          aria-label="选择状态{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>
  </view>

  <!-- 日期面板 -->
  <view wx:if="{{showDatePanel}}" class="panel-mask" catchtap="closeDatePanel">
    <view class="category-panel" catchtap="noop">
      <view class="panel-head">
        <view class="panel-actions" style="grid-template-columns: 1fr;">
          <button class="panel-close" bindtap="closeDatePanel">关闭</button>
        </view>
      </view>
      <view class="date-panel">
        <view class="quick-date-row">
          <button class="quick-date-btn" data-offset="0" bindtap="selectQuickDate">今天</button>
          <button class="quick-date-btn" data-offset="-1" bindtap="selectQuickDate">昨天</button>
          <button class="quick-date-btn" data-offset="-7" bindtap="selectQuickDate">一周前</button>
          <button class="quick-date-btn" data-offset="-30" bindtap="selectQuickDate">一月前</button>
        </view>
        <picker mode="date" value="{{form.purchaseDate}}" bindchange="onDateChange">
          <view class="date-picker-row">
            <view>
              <view class="date-picker-title">选择具体日期</view>
              <view class="date-picker-value">{{form.purchaseDate || '未选择'}}</view>
            </view>
            <text class="trigger-arrow">›</text>
          </view>
        </picker>
        <button class="date-clear" data-offset="-999" bindtap="selectQuickDate">清空日期</button>
      </view>
    </view>
  </view>
</view>
