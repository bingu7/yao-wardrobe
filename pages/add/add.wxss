.form-title {
  padding-top: 16rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.upload {
  position: relative;
  height: 420rpx;
  margin-top: 28rpx;
  overflow: hidden;
}

.upload-image,
.upload-empty {
  width: 100%;
  height: 100%;
}

.upload-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #efe3dc;
}

.upload-plus {
  font-size: 64rpx;
  line-height: 1;
}

.remove-image {
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  width: 104rpx;
  height: 56rpx;
  border-radius: 8rpx;
  background: rgba(45, 37, 34, 0.82);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1;
  padding: 0;
}

.field {
  margin-top: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #5f514a;
  font-size: 26rpx;
  font-weight: 600;
}

.required {
  color: #9d3f35;
}

.input,
.picker-value,
.textarea {
  width: 100%;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  background: #ffffff;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.input,
.picker-value {
  height: 82rpx;
  line-height: 82rpx;
}

.picker-value {
  color: #2d2522;
}

.category-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trigger-arrow {
  color: #8b7d75;
  font-size: 36rpx;
  line-height: 1;
}

.custom-category {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 14rpx;
}

.custom-category.compact {
  grid-template-columns: minmax(0, 1fr) 160rpx;
  gap: 12rpx;
  align-items: center;
}

.custom-input {
  width: 100%;
  height: 72rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  background: #ffffff;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.custom-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: 72rpx;
  border-radius: 8rpx;
  background: #2d2522;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 1;
  padding: 0;
}

.compact .custom-button {
  width: 160rpx;
  font-size: 24rpx;
}

.custom-list {
  display: grid;
  gap: 10rpx;
  margin-top: 14rpx;
  width: 100%;
}

.compact-list {
  grid-template-columns: repeat(2, 1fr);
}

.custom-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 64rpx;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
  min-width: 0;
  overflow: hidden;
  padding: 8rpx 10rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  background: #fffaf6;
}

.custom-name {
  color: #5f514a;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.custom-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 64rpx;
  min-width: 0;
  height: 40rpx;
  border-radius: 8rpx;
  background: #7b3b32;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.custom-delete::after,
.custom-toggle::after {
  border: 0;
}

.custom-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 48rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  background: #ffffff;
  color: #7b3b32;
  font-size: 22rpx;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.compact-list .custom-toggle {
  grid-column: 1 / -1;
}

.textarea {
  min-height: 160rpx;
  padding-top: 20rpx;
}

.has-error {
  border-color: #b44a3f;
}

.error-text {
  margin-top: 10rpx;
  color: #b44a3f;
  font-size: 24rpx;
  line-height: 1.4;
}

.chip-row {
  display: flex;
  gap: 14rpx;
}

.chip-row.wrap {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 64rpx;
  border: 1rpx solid #d9c8bd;
  border-radius: 8rpx;
  background: #fffaf6;
  color: #5f514a;
  font-size: 26rpx;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.occasion-chip {
  width: 100%;
  height: 64rpx;
  font-size: 24rpx;
}

.chip.active {
  background: #2d2522;
  color: #ffffff;
  border-color: #2d2522;
}

.occasion-toggle,
.manage-occasion-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 56rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1;
  margin: 12rpx 0 0;
  padding: 0;
}

.occasion-toggle {
  border: 1rpx solid #eadfd7;
  background: #ffffff;
  color: #7b3b32;
}

.manage-occasion-button {
  border: 1rpx dashed #d9c8bd;
  background: #fffaf6;
  color: #5f514a;
}

.occasion-toggle::after,
.manage-occasion-button::after {
  border: 0;
}

.button-stack {
  display: grid;
  gap: 18rpx;
  margin-top: 36rpx;
}

.panel-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(45, 37, 34, 0.42);
}

.category-panel {
  box-sizing: border-box;
  width: 100%;
  max-height: 72vh;
  padding: 24rpx 28rpx 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #fffaf6;
  overflow-y: auto;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  width: 100%;
}

.panel-action,
.panel-close,
.mini-button,
.delete-x {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  line-height: 1;
}

.panel-action::after,
.panel-close::after,
.mini-button::after,
.delete-x::after {
  border: 0;
}

.panel-action,
.panel-close {
  width: 100%;
  height: 56rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.panel-action {
  background: #2d2522;
  color: #ffffff;
}

.panel-close {
  border: 1rpx solid #eadfd7;
  background: #ffffff;
  color: #5f514a;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 26rpx;
}

.category-chip {
  display: flex;
  position: relative;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 68rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  background: #ffffff;
  color: #5f514a;
  font-size: 24rpx;
  line-height: 1;
  padding: 0 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-chip.selected {
  border-color: #2d2522;
  background: #2d2522;
  color: #ffffff;
}

.category-edit-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 26rpx;
}

.category-edit-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 48rpx;
  gap: 10rpx;
  align-items: center;
  min-width: 0;
  width: 100%;
  overflow: hidden;
  padding: 12rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  background: #ffffff;
}

.category-edit-input {
  grid-column: 1;
  grid-row: 1;
  width: 100%;
  height: 56rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  padding: 0 14rpx;
  color: #2d2522;
  font-size: 24rpx;
}

.category-card-actions {
  grid-column: 1 / -1;
  grid-row: 2;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  width: 100%;
  overflow: hidden;
}

.mini-button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 44rpx;
  border-radius: 8rpx;
  border: 1rpx solid #eadfd7;
  background: #fffaf6;
  color: #5f514a;
  font-size: 21rpx;
  white-space: nowrap;
}

.mini-button[disabled] {
  color: #c7b8af;
  background: #f4ece7;
}

.delete-x {
  grid-column: 2;
  grid-row: 1;
  width: 48rpx;
  min-width: 48rpx;
  max-width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #7b3b32;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 48rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
}

.panel-add {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 128rpx;
  gap: 12rpx;
  margin-top: 22rpx;
}

.panel-add .custom-button {
  width: 128rpx;
  font-size: 24rpx;
}

/* 日期面板 */
.date-panel {
  box-sizing: border-box;
  width: 100%;
  margin-top: 26rpx;
}

.quick-date-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.quick-date-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 68rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  background: #ffffff;
  color: #5f514a;
  font-size: 24rpx;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.quick-date-btn::after {
  border: 0;
}

.date-picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin-top: 18rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  background: #ffffff;
  padding: 16rpx 20rpx;
}

.date-picker-title {
  font-size: 26rpx;
  color: #2d2522;
  font-weight: 600;
}

.date-picker-value {
  margin-top: 8rpx;
  color: #9a8b83;
  font-size: 24rpx;
}

.date-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 56rpx;
  margin-top: 18rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  background: #ffffff;
  color: #b44a3f;
  font-size: 24rpx;
  line-height: 1;
  padding: 0;
}

.date-clear::after {
  border: 0;
}
