.page {
  min-height: 100vh;
  padding: 36rpx 32rpx 80rpx;
  box-sizing: border-box;
  background: #f8f5f1;
  color: #2f2926;
}

.eyebrow {
  color: #9b463f;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.title {
  margin-top: 8rpx;
  font-size: 48rpx;
  line-height: 1.1;
  font-weight: 800;
}

.subtitle {
  margin-top: 10rpx;
  color: #9a8b83;
  font-size: 28rpx;
  line-height: 1.45;
}

.card {
  background: #fffdfa;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.section {
  margin-top: 28rpx;
  padding: 28rpx;
}

.block-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #302724;
}

.paragraph,
.notice,
.hint {
  margin-top: 14rpx;
  color: #8d7d75;
  font-size: 26rpx;
  line-height: 1.55;
}

.notice {
  padding: 18rpx;
  color: #7b3b32;
  background: #fbf1ed;
  border-radius: 8rpx;
}

.hint {
  font-size: 24rpx;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.action,
.danger-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 156rpx;
  height: 64rpx;
  padding: 0 28rpx;
  border: 1rpx solid #dfd2ca;
  border-radius: 999rpx;
  color: #6e5b54;
  font-size: 26rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.action.primary {
  color: #fffdfa;
  background: #2f241f;
  border-color: #2f241f;
}

.backup-ready {
  margin-top: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  background: #fbf7f3;
}

.backup-ready-title {
  color: #3c312d;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.5;
  word-break: break-all;
}

.devtools-notice,
.backup-action-message {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.devtools-notice {
  color: #7b3b32;
  background: #fbf1ed;
}

.backup-action-message {
  color: #6e5b54;
  background: #f2ebe5;
}

.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  border-bottom: 1rpx solid #f0e7e0;
  color: #3c312d;
  font-size: 28rpx;
}

.link-row:last-child {
  border-bottom: 0;
}

.chevron {
  color: #aa9b93;
  font-size: 42rpx;
}

.danger-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 28rpx;
  padding: 28rpx;
}

.danger-action {
  flex: 0 0 auto;
  color: #9b3b34;
  border-color: #c58c84;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  background: rgba(47, 36, 31, 0.38);
  box-sizing: border-box;
}

.import-panel {
  width: 100%;
  padding: 30rpx;
  background: #fffdfa;
  border-radius: 16rpx 16rpx 8rpx 8rpx;
  box-sizing: border-box;
}

.import-title {
  font-size: 32rpx;
  font-weight: 800;
}

.backup-input {
  width: 100%;
  height: 300rpx;
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  color: #3a302c;
  font-size: 26rpx;
  line-height: 1.5;
  box-sizing: border-box;
  background: #fff;
}
