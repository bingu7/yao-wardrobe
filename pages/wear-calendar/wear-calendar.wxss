.eyebrow {
  padding-top: 8rpx;
  color: #8b3f37;
  font-size: 20rpx;
  font-weight: 600;
}

.title {
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.12;
}

.subtitle {
  margin-top: 8rpx;
  color: #9a8b83;
  font-size: 25rpx;
  line-height: 1.5;
}

.today-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
  background: rgba(255, 252, 248, 0.86);
}

.card-label,
.block-subtitle,
.option-meta {
  color: #9a8b83;
  font-size: 23rpx;
}

.today-count {
  margin-top: 6rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.date-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 214rpx;
  height: 62rpx;
  border: 1rpx solid #daccc4;
  border-radius: 8rpx;
  background: #fffaf6;
  color: #2a2421;
  font-size: 25rpx;
}

.day-strip {
  width: 100%;
  white-space: nowrap;
}

.day-pill {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 92rpx;
  border: 1rpx solid #daccc4;
  border-radius: 10rpx;
  background: rgba(255, 252, 248, 0.82);
  color: #5f514a;
  margin: 0 12rpx 0 0;
  padding: 0;
}

.day-pill.active {
  border-color: #241f1d;
  background: #241f1d;
  color: #ffffff;
}

.day-date {
  font-size: 25rpx;
  font-weight: 700;
}

.day-count {
  margin-top: 8rpx;
  font-size: 21rpx;
}

.day-pill::after,
.clear-button::after,
.item-option::after {
  border: 0;
}

.record-card {
  padding: 24rpx;
  background: rgba(255, 252, 248, 0.86);
}

.block-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
}

.clear-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 108rpx;
  height: 52rpx;
  border: 1rpx solid #c05f55;
  border-radius: 999rpx;
  background: transparent;
  color: #c05f55;
  font-size: 23rpx;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.selected-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.selected-chip {
  max-width: 100%;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #efe3dc;
  color: #5f514a;
  font-size: 23rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.item-option {
  display: grid;
  grid-template-columns: 74rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  height: 96rpx;
  border-color: #e8ded6;
  background: rgba(255, 252, 248, 0.82);
  color: #2a2421;
  margin: 0;
  padding: 10rpx;
  text-align: left;
}

.item-option.selected {
  border-color: #241f1d;
  background: #f0e5df;
}

.option-image {
  width: 74rpx;
  height: 74rpx;
  border-radius: 8rpx;
  background: #efe3dc;
  overflow: hidden;
}

.option-image image,
.option-placeholder {
  width: 100%;
  height: 100%;
}

.option-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9a8b83;
  font-size: 18rpx;
  text-align: center;
}

.option-body {
  min-width: 0;
}

.option-name {
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-actions {
  position: fixed;
  left: 30rpx;
  right: 30rpx;
  bottom: 28rpx;
  z-index: 10;
}
