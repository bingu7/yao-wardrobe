<view class="page">
  <view class="form-head">
    <button class="back-button" bindtap="goBack">返回</button>
    <view>
      <view class="title">添加穿搭</view>
      <view class="subtitle">选择至少两件衣物保存成一套</view>
    </view>
  </view>

  <view class="builder card section">
    <view class="field">
      <text class="label">穿搭名字</text>
      <input class="input" placeholder="例如：周末拍照穿搭" value="{{form.name}}" data-field="name" bindinput="onInput" maxlength="24" />
    </view>

    <view wx:for="{{slots}}" wx:key="key" class="field">
      <text class="label">{{item.label}}</text>
      <picker mode="selector" range="{{item.options}}" range-key="name" value="{{item.index}}" data-index="{{index}}" bindchange="onSlotChange">
        <view class="picker-value">{{item.displayName}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">场合</text>
      <picker mode="selector" range="{{occasionOptions}}" value="{{occasionIndex}}" bindchange="onOccasionChange">
        <view class="picker-value">{{occasionLabel}}</view>
      </picker>
    </view>

    <view class="field">
      <text class="label">备注</text>
      <textarea class="textarea" placeholder="比如：适合拍照、旅行、约会" value="{{form.note}}" data-field="note" bindinput="onInput" />
    </view>
  </view>

  <button class="primary-button save-button" bindtap="saveOutfit">保存穿搭</button>
</view>
