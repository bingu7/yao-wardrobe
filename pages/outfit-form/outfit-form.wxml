<view class="page">
  <view class="form-head">
    <button class="back-button" bindtap="goBack">返回</button>
    <view>
      <view class="title">添加穿搭</view>
      <view class="subtitle">选好衣物自由搭配</view>
    </view>
  </view>

  <view class="card section builder">
    <view class="field">
      <text class="label">穿搭名字</text>
      <input class="input" placeholder="例如：周末约会穿搭" value="{{form.name}}" data-field="name" bindinput="onInput" maxlength="20" />
    </view>

    <view class="field">
      <text class="label">场合</text>
      <view class="picker-value category-trigger" bindtap="openOccasionPanel" aria-label="选择穿搭场合">
        <text>{{occasionLabel}}</text>
        <text class="trigger-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card section builder">
    <view class="block-title">
      搭配衣物
      <text class="piece-hint">已选 {{pieces.length}} 件</text>
    </view>

    <view wx:for="{{pieces}}" wx:key="index" class="piece-form" data-index="{{index}}">
      <view class="piece-header">
        <text class="piece-num">第{{index + 1}}件</text>
        <button wx:if="{{pieces.length > 1}}" class="remove-piece" data-index="{{index}}" bindtap="removePiece">移除</button>
      </view>

      <view class="field">
        <text class="label">选择分类</text>
        <view class="picker-value category-trigger" data-index="{{index}}" bindtap="openCategoryPanel" aria-label="选择第{{index}}件衣物分类">
          <text>{{item.categoryName || '选择分类'}}</text>
          <text class="trigger-arrow">›</text>
        </view>
      </view>

      <view class="field">
        <text class="label">选择衣物</text>
        <view class="picker-value category-trigger" data-index="{{index}}" bindtap="openItemPanel" aria-label="选择第{{index}}件衣物">
          <text>{{item.displayName}}</text>
          <text class="trigger-arrow">›</text>
        </view>
      </view>
    </view>

    <button wx:if="{{pieces.length < 5}}" class="ghost-button add-piece-btn" bindtap="addPiece">+ 再添加一件</button>
  </view>

  <view class="field" style="margin-top: 22rpx;">
    <text class="label">备注</text>
    <textarea class="textarea" placeholder="穿搭的风格、适合的场景" value="{{form.note}}" data-field="note" bindinput="onInput" />
  </view>

  <button class="primary-button save-button" bindtap="saveOutfit">保存穿搭</button>

  <!-- 分类面板 -->
  <view wx:if="{{showCategoryPanel}}" class="panel-mask" catchtap="closeCategoryPanel">
    <view class="category-panel" catchtap="noop">
      <view class="panel-head">
        <view class="panel-title">选择衣橱分类</view>
        <view class="panel-actions single">
          <button class="panel-close" bindtap="closeCategoryPanel">关闭</button>
        </view>
      </view>

      <view wx:if="{{categoryPanelItems.length}}" class="category-grid">
        <view
          wx:for="{{categoryPanelItems}}"
          wx:key="name"
          class="category-chip {{item.selected ? 'selected' : ''}}"
          data-category="{{item.name}}"
          bindtap="selectCategoryFromPanel"
          aria-label="选择分类{{item.name}}"
        >
          {{item.name}}
        </view>
      </view>
      <view wx:else class="panel-empty">衣橱里还没有衣物，请先添加衣物</view>
    </view>
  </view>

  <!-- 场合面板（简单选择，无编辑） -->
  <view wx:if="{{showOccasionPanel}}" class="panel-mask" catchtap="closeOccasionPanel">
    <view class="category-panel" catchtap="noop">
      <view class="panel-head">
        <view class="panel-actions">
          <button class="panel-close" bindtap="closeOccasionPanel">关闭</button>
        </view>
      </view>
      <view class="category-grid">
        <view
          wx:for="{{occasionOptions}}"
          wx:key="*this"
          class="category-chip {{item === occasionLabel ? 'selected' : ''}}"
          data-occasion="{{item}}"
          bindtap="selectOccasion"
        >
          {{item}}
        </view>
      </view>
    </view>
  </view>

  <!-- 物品选择面板 -->
  <view wx:if="{{showItemPanel}}" class="panel-mask" catchtap="closeItemPanel">
    <view class="category-panel" catchtap="noop">
      <view class="panel-head">
        <view class="panel-actions">
          <button class="panel-close" bindtap="closeItemPanel">关闭</button>
        </view>
      </view>
      <view class="match-list">
        <view
          wx:for="{{pieces[editingItemPieceIndex].itemOptions}}"
          wx:key="id"
          class="match-row {{item.id === pieces[editingItemPieceIndex].itemId ? 'selected' : ''}}"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="selectItem"
          aria-label="选择衣物{{item.name}}"
        >
          <view class="match-name">{{item.name}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
