.form-head {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding-top: 16rpx;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 112rpx;
  height: 64rpx;
  border: 1rpx solid #d9c8bd;
  border-radius: 8rpx;
  background: #fffaf6;
  color: #2d2522;
  font-size: 26rpx;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 8rpx;
  color: #8b7d75;
  font-size: 26rpx;
  line-height: 1.5;
}

.builder {
  padding: 24rpx;
}

.field {
  margin-top: 22rpx;
}

.field:first-child {
  margin-top: 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #5f514a;
  font-size: 26rpx;
  font-weight: 600;
}

.input,
.picker-value,
.textarea {
  width: 100%;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  background: #ffffff;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.input,
.picker-value {
  height: 82rpx;
  line-height: 82rpx;
}

.textarea {
  min-height: 150rpx;
  padding-top: 20rpx;
}

.save-button {
  margin-top: 30rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.piece-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #9a8b83;
}

.piece-form {
  padding: 20rpx 0;
  border-top: 1rpx solid #e8ded6;
}

.piece-form:first-of-type {
  border-top: 0;
}

.piece-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.piece-num {
  font-size: 26rpx;
  font-weight: 600;
  color: #8b3f37;
}

.remove-piece {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 72rpx;
  border: 1rpx solid #b44a3f;
  border-radius: 999rpx;
  background: transparent;
  color: #b44a3f;
  font-size: 22rpx;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.remove-piece::after {
  border: 0;
}

.add-piece-btn {
  margin-top: 20rpx;
}

/* 分类面板（复用添加页面板样式） */
.panel-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(45, 37, 34, 0.42);
}

.category-panel {
  width: 100%;
  max-height: 72vh;
  padding: 24rpx 28rpx 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #fffaf6;
  overflow-y: auto;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.panel-title {
  color: #2d2522;
  font-size: 28rpx;
  font-weight: 700;
}

.panel-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  width: 100%;
}

.panel-actions.single {
  display: block;
  width: 112rpx;
}

.panel-close {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  line-height: 1;
}

.panel-close::after {
  border: 0;
}

.panel-close {
  width: 100%;
  height: 72rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.panel-close {
  border: 1rpx solid #eadfd7;
  background: #ffffff;
  color: #5f514a;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 26rpx;
}

.category-chip {
  display: flex;
  position: relative;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 76rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  background: #ffffff;
  color: #5f514a;
  font-size: 24rpx;
  line-height: 1;
  padding: 0 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-chip.selected {
  border-color: #2d2522;
  background: #2d2522;
  color: #ffffff;
}

.panel-empty {
  margin-top: 26rpx;
  padding: 42rpx 20rpx;
  border-radius: 8rpx;
  background: #f5eee9;
  color: #8b7d75;
  font-size: 24rpx;
  text-align: center;
}

.category-trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trigger-arrow {
  color: #8b7d75;
  font-size: 36rpx;
  line-height: 1;
}

/* 物品列表（复用搭配衣物面板的样式） */
.match-list {
  margin-top: 26rpx;
  display: grid;
  gap: 10rpx;
}

.match-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid #eadfd7;
  border-radius: 8rpx;
  background: #ffffff;
}

.match-row.selected {
  border-color: #2d2522;
  background: #f5f0eb;
}

.match-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #2d2522;
}
