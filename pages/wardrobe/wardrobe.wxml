<view class="page">
  <view class="hero">
    <view>
      <view class="eyebrow">TODAY'S CLOSET</view>
      <view class="title">我的衣橱</view>
      <view class="subtitle">把喜欢的裙子和衣服都收好</view>
    </view>
    <view class="hero-btns">
      <button class="manage-btn" bindtap="openManagePanel">管理</button>
      <button class="add-btn" bindtap="goAdd">+ 添加</button>
    </view>
  </view>

  <view class="overview">
    <view class="overview-item card">
      <text class="overview-value">{{summary.totalCount}}</text>
      <text class="overview-label">总件数</text>
    </view>
    <view class="overview-item card">
      <text class="overview-value">¥{{summary.totalPrice}}</text>
      <text class="overview-label">总花费</text>
    </view>
    <view class="overview-item card">
      <text class="overview-value">{{summary.idleCount}}</text>
      <text class="overview-label">闲置</text>
    </view>
  </view>

  <view class="search-row">
    <input class="search-input" placeholder="搜索衣物名字" value="{{keyword}}" bindinput="onSearch" />
  </view>

  <view class="category-filter">
    <view class="category-row">
      <button
        wx:for="{{visibleCategories}}"
        wx:key="*this"
        class="category-pill {{activeCategory === item ? 'active' : ''}}"
        data-category="{{item}}"
        bindtap="setCategory"
      >
        {{item}}
      </button>
    </view>
    <button wx:if="{{canToggleCategories}}" class="category-toggle" bindtap="toggleCategories">{{categoryToggleText}}</button>
  </view>

  <view wx:if="{{filteredItems.length}}" class="grid section">
    <view
      wx:for="{{filteredItems}}"
      wx:key="id"
      class="item-card card"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="image-wrap">
        <image wx:if="{{item.imageUrl}}" class="item-image" src="{{item.imageUrl}}" mode="aspectFill" />
        <view wx:else class="image-placeholder">{{item.category}}</view>
      </view>
      <view class="item-body">
        <view class="item-name">{{item.name}}</view>
        <view class="item-meta">
          <text>{{item.category}}</text>
          <text wx:if="{{item.price}}">¥{{item.price}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty card">
    <view class="empty-title">还没有找到衣物</view>
    <view class="empty-text">换个分类或添加第一件衣服。</view>
    <button class="primary-button empty-button" bindtap="goAdd">添加衣物</button>
  </view>

  <!-- 管理面板 -->
  <view wx:if="{{showManagePanel}}" class="panel-mask" catchtap="closeManagePanel">
    <view class="category-panel" catchtap="noop">
      <view class="panel-head">
        <view class="manage-tabs">
          <button class="manage-tab {{manageTab === 'category' ? 'active' : ''}}" data-tab="category" bindtap="switchManageTab">分类</button>
          <button class="manage-tab {{manageTab === 'occasion' ? 'active' : ''}}" data-tab="occasion" bindtap="switchManageTab">场合</button>
          <button class="panel-close manage-close" bindtap="closeManagePanel">完成</button>
        </view>
      </view>

      <!-- 分类管理 -->
      <view wx:if="{{manageTab === 'category'}}">
        <view class="panel-head" style="margin-top: 12rpx;">
          <view class="panel-actions" style="grid-template-columns: 1fr;">
            <button class="panel-action" bindtap="toggleCategoryEditing">{{isCategoryEditing ? '完成编辑' : '编辑分类'}}</button>
          </view>
        </view>

        <view wx:if="{{!isCategoryEditing}}" class="category-grid" style="margin-top: 14rpx;">
          <view
            wx:for="{{categoryPanelItems}}"
            wx:key="name"
            class="category-chip"
            data-category="{{item.name}}"
          >
            {{item.name}}
          </view>
        </view>

        <view wx:else class="category-edit-list">
          <view wx:for="{{categoryPanelItems}}" wx:key="name" class="category-edit-card">
            <button class="delete-x" data-category="{{item.name}}" catchtap="deleteCustomCategory">×</button>
            <input class="category-edit-input" value="{{item.draftName}}" data-index="{{index}}" bindinput="onCategoryDraftInput" maxlength="10" />
            <view class="category-card-actions">
              <button class="mini-button save-mini" data-index="{{index}}" bindtap="renameCategoryFromPanel">保存</button>
              <button class="mini-button" disabled="{{!item.canMoveUp}}" data-category="{{item.name}}" data-direction="-1" bindtap="moveCategoryFromPanel">上移</button>
              <button class="mini-button" disabled="{{!item.canMoveDown}}" data-category="{{item.name}}" data-direction="1" bindtap="moveCategoryFromPanel">下移</button>
            </view>
          </view>
        </view>

        <view class="panel-add">
          <input class="custom-input" placeholder="添加新分类" value="{{customCategory}}" bindinput="onCustomCategoryInput" maxlength="10" />
          <button class="custom-button" bindtap="addCustomCategory">添加</button>
        </view>
      </view>

      <!-- 场合管理 -->
      <view wx:if="{{manageTab === 'occasion'}}">
        <view class="category-edit-list" style="margin-top: 18rpx;">
          <view wx:for="{{occasionPanelItems}}" wx:key="name" class="category-edit-card">
            <button class="delete-x" data-occasion="{{item.name}}" catchtap="deleteCustomOccasion">×</button>
            <input class="category-edit-input" value="{{item.draftName}}" data-index="{{index}}" bindinput="onOccasionDraftInput" maxlength="10" />
            <view class="category-card-actions">
              <button class="mini-button save-mini" data-index="{{index}}" bindtap="renameOccasionFromPanel">保存</button>
              <button class="mini-button" disabled="{{!item.canMoveUp}}" data-occasion="{{item.name}}" data-direction="-1" bindtap="moveOccasionFromPanel">上移</button>
              <button class="mini-button" disabled="{{!item.canMoveDown}}" data-occasion="{{item.name}}" data-direction="1" bindtap="moveOccasionFromPanel">下移</button>
            </view>
          </view>
        </view>

        <view class="panel-add">
          <input class="custom-input" placeholder="添加新场合" value="{{customOccasion}}" bindinput="onCustomOccasionInput" maxlength="10" />
          <button class="custom-button" bindtap="addCustomOccasion">添加</button>
        </view>
      </view>
    </view>
  </view>
</view>