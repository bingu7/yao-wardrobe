<view class="page">
  <view class="hero">
    <view>
      <view class="eyebrow">TODAY'S CLOSET</view>
      <view class="title">我的衣橱</view>
      <view class="subtitle">把喜欢的裙子和衣服都收好</view>
    </view>
    <view class="add-btn" role="button" aria-label="添加衣物" bindtap="goAdd">＋ 添加</view>
  </view>

  <view class="overview">
    <view class="overview-item card">
      <text class="overview-value">{{summary.totalCount}}</text>
      <text class="overview-label">总件数</text>
    </view>
    <view class="overview-item card">
      <text class="overview-value">¥{{summary.totalPrice}}</text>
      <text class="overview-label">总花费</text>
    </view>
    <view class="overview-item card">
      <text class="overview-value">{{summary.idleCount}}</text>
      <text class="overview-label">闲置</text>
    </view>
  </view>

  <view class="calendar-card card" bindtap="openWearCalendar">
    <view>
      <view class="calendar-title">今日穿搭日历</view>
      <view class="calendar-subtitle">今天已记录 {{insights.todayRecordCount}} 件，点这里补记每天穿了什么</view>
    </view>
    <view class="calendar-link">记录</view>
  </view>

  <view class="insight-section" wx:if="{{insights.recentItems.length}}">
    <view class="section-head">
      <view class="section-title">最近穿过</view>
    </view>
    <scroll-view class="insight-scroll" scroll-x>
      <view
        wx:for="{{insights.recentItems}}"
        wx:key="id"
        class="mini-piece"
        data-id="{{item.id}}"
        bindtap="goDetail"
      >
        <view class="mini-image">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" data-image-url="{{item.imageUrl}}" binderror="onImageError" />
          <view wx:else class="mini-placeholder">{{item.category}}</view>
        </view>
        <view class="mini-name">{{item.name}}</view>
        <view class="mini-meta">{{item.lastWornDate}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="insight-section" wx:if="{{insights.staleItems.length}}">
    <view class="section-head">
      <view class="section-title">久未穿着</view>
      <view class="section-note">超过 {{idleAlertDays}} 天未穿，或暂未记录穿着</view>
    </view>
    <scroll-view class="insight-scroll" scroll-x>
      <view
        wx:for="{{insights.staleItems}}"
        wx:key="id"
        class="mini-piece"
        data-id="{{item.id}}"
        bindtap="goDetail"
      >
        <view class="mini-image">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" data-image-url="{{item.imageUrl}}" binderror="onImageError" />
          <view wx:else class="mini-placeholder">{{item.category}}</view>
        </view>
        <view class="mini-name">{{item.name}}</view>
        <view class="mini-meta">{{item.idleText}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="insight-section" wx:if="{{insights.weeklyItems.length}}">
    <view class="section-head">
      <view class="section-title">本周推荐</view>
      <view class="section-note">{{insights.currentSeason}}季可穿</view>
    </view>
    <scroll-view class="insight-scroll" scroll-x>
      <view
        wx:for="{{insights.weeklyItems}}"
        wx:key="id"
        class="mini-piece"
        data-id="{{item.id}}"
        bindtap="goDetail"
      >
        <view class="mini-image">
          <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" data-image-url="{{item.imageUrl}}" binderror="onImageError" />
          <view wx:else class="mini-placeholder">{{item.category}}</view>
        </view>
        <view class="mini-name">{{item.name}}</view>
        <view class="mini-meta">{{item.wearCount || 0}} 次</view>
      </view>
    </scroll-view>
  </view>

  <view class="search-row">
    <input class="search-input" placeholder="搜索名字、颜色、备注或场合" value="{{keyword}}" bindinput="onSearch" />
  </view>

  <view wx:if="{{!batchMode}}" class="filter-head">
    <view class="filter-label">按分类浏览</view>
    <view class="batch-button" role="button" aria-label="批量管理衣物" bindtap="enterBatchMode">批量管理</view>
  </view>

  <view wx:if="{{batchMode}}" class="batch-toolbar card">
    <view class="batch-head">
      <view class="batch-title">批量管理</view>
      <view class="selected-count">已选 {{selectedItemIds.length}} 件</view>
    </view>
    <view class="batch-quick">
      <button bindtap="selectAllFiltered">全选当前</button>
      <button bindtap="exitBatchMode">取消</button>
    </view>
    <view class="batch-actions">
      <button bindtap="openBatchCategoryPanel">改分类</button>
      <button bindtap="openBatchOccasionPanel">加场合</button>
      <button class="danger" bindtap="confirmBatchDelete">删除</button>
    </view>
  </view>

  <view class="category-filter">
    <view class="category-row">
      <view
        wx:for="{{visibleCategories}}"
        wx:key="*this"
        class="category-pill {{activeCategory === item ? 'active' : ''}}"
        role="button"
        aria-label="按{{item}}筛选"
        data-category="{{item}}"
        bindtap="setCategory"
      >
        {{item}}
      </view>
    </view>
    <view wx:if="{{canToggleCategories}}" class="category-toggle" role="button" bindtap="toggleCategories">{{categoryToggleText}}</view>
  </view>

  <view wx:if="{{filteredItems.length}}" class="grid section">
    <view
      wx:for="{{filteredItems}}"
      wx:key="id"
      class="item-card card {{batchMode ? 'selectable' : ''}} {{item.selected ? 'selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="handleItemTap"
    >
      <view class="image-wrap">
        <image wx:if="{{item.imageUrl}}" class="item-image" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.id}}" data-image-url="{{item.imageUrl}}" binderror="onImageError" />
        <view wx:else class="image-placeholder">{{item.category}}</view>
        <view wx:if="{{batchMode}}" class="select-mark {{item.selected ? 'active' : ''}}">{{item.selected ? '✓' : ''}}</view>
      </view>
      <view class="item-body">
        <view class="item-name">{{item.name}}</view>
        <view class="item-meta">
          <text>{{item.category}}</text>
          <text wx:if="{{item.price}}">¥{{item.price}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty card">
    <view class="empty-title">还没有找到衣物</view>
    <view class="empty-text">换个分类或添加第一件衣服。</view>
    <button class="primary-button empty-button" bindtap="goAdd">添加衣物</button>
  </view>

  <view wx:if="{{showBatchCategoryPanel}}" class="modal-mask" bindtap="closeBatchCategoryPanel">
    <view class="batch-panel" catchtap="noop">
      <view class="panel-title">批量修改分类</view>
      <view class="panel-grid">
        <button wx:for="{{batchCategories}}" wx:key="*this" data-category="{{item}}" bindtap="applyBatchCategory">{{item}}</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showBatchOccasionPanel}}" class="modal-mask" bindtap="closeBatchOccasionPanel">
    <view class="batch-panel" catchtap="noop">
      <view class="panel-title">批量添加场合</view>
      <view class="panel-grid">
        <button wx:for="{{batchOccasions}}" wx:key="*this" data-occasion="{{item}}" bindtap="applyBatchOccasion">{{item}}</button>
      </view>
    </view>
  </view>
</view>
