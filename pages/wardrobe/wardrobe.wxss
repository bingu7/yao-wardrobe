.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 6rpx;
}

.eyebrow {
  color: #8b3f37;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.title {
  margin-top: 12rpx;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.08;
}

.subtitle {
  margin-top: 10rpx;
  color: #6b5a52;
  font-size: 26rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 126rpx;
  height: 56rpx;
  border: 1rpx solid #2a2421;
  border-radius: 999rpx;
  background: #2a2421;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  margin: 10rpx 0 0;
  padding: 0;
}

.add-btn::after,
.category-pill::after,
.category-toggle::after {
  border: 0;
}

.overview {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 32rpx;
}

.overview-item {
  padding: 20rpx 18rpx;
  background: rgba(255, 252, 248, 0.72);
}

.overview-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.overview-label {
  display: block;
  margin-top: 6rpx;
  color: #9a8b83;
  font-size: 22rpx;
}

.search-row {
  margin-top: 28rpx;
}

.backup-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 12rpx;
  width: calc(100% - 24rpx);
  box-sizing: border-box;
  margin-top: 14rpx;
}

.backup-button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  height: 72rpx;
  border: 1rpx solid #d9c8bd;
  border-radius: 10rpx;
  background: #fffaf6;
  color: #5f514a;
  font-size: 24rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0;
}

.backup-button::after {
  border: 0;
}

.search-input {
  height: 82rpx;
  border: 1rpx solid #e8ded6;
  border-radius: 10rpx;
  background: rgba(255, 252, 248, 0.9);
  padding: 0 26rpx;
  font-size: 28rpx;
}

.category-filter {
  margin-top: 24rpx;
}

.category-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 100%;
}

.category-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 calc(50% - 6rpx);
  width: calc(50% - 6rpx);
  max-width: calc(50% - 6rpx);
  min-width: 0;
  height: 72rpx;
  box-sizing: border-box;
  border: 1rpx solid #daccc4;
  border-radius: 999rpx;
  background: transparent;
  color: #5f514a;
  font-size: 24rpx;
  font-weight: 500;
  margin: 0 0 12rpx;
  padding: 0 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-pill.active {
  background: #241f1d;
  color: #ffffff;
  border-color: #241f1d;
}

.category-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48%;
  height: 72rpx;
  border: 1rpx solid #e8ded6;
  border-radius: 999rpx;
  background: rgba(255, 252, 248, 0.7);
  color: #8b3f37;
  font-size: 23rpx;
  line-height: 1;
  margin: 12rpx auto 0;
  padding: 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx 18rpx;
}

.item-card {
  overflow: hidden;
  border-color: transparent;
  background: transparent;
}

.image-wrap {
  width: 100%;
  aspect-ratio: 1 / 1.24;
  background: #efe3dc;
  border-radius: 10rpx;
  overflow: hidden;
}

.item-image,
.image-placeholder {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b5a52;
  font-size: 26rpx;
}

.item-body {
  padding: 16rpx 4rpx 0;
}

.item-name {
  font-size: 29rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  color: #6b5a52;
  font-size: 24rpx;
}

.empty {
  margin-top: 36rpx;
  padding: 48rpx 28rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 10rpx;
  color: #6b5a52;
  font-size: 26rpx;
}

.empty-button {
  margin-top: 28rpx;
}

/* 穿搭日历、衣橱洞察与批量管理模块 */
.calendar-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  background: rgba(255, 252, 248, 0.82);
}

.calendar-title,
.section-title,
.batch-title,
.panel-title {
  font-size: 30rpx;
  font-weight: 700;
}

.calendar-subtitle {
  margin-top: 8rpx;
  color: #8b7d75;
  font-size: 23rpx;
  line-height: 1.4;
}

.calendar-link {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 92rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: #241f1d;
  color: #ffffff;
  font-size: 23rpx;
}

.insight-section {
  margin-top: 26rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.section-note {
  flex: 0 0 auto;
  color: #9a8b83;
  font-size: 22rpx;
}

.insight-scroll {
  width: 100%;
  white-space: nowrap;
}

.mini-piece {
  display: inline-block;
  width: 152rpx;
  margin-right: 16rpx;
  vertical-align: top;
}

.mini-image {
  width: 152rpx;
  height: 176rpx;
  border-radius: 10rpx;
  background: #efe3dc;
  overflow: hidden;
}

.mini-image image,
.mini-placeholder {
  width: 100%;
  height: 100%;
}

.mini-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9a8b83;
  font-size: 22rpx;
  text-align: center;
}

.mini-name,
.mini-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-name {
  margin-top: 10rpx;
  color: #2a2421;
  font-size: 24rpx;
  font-weight: 700;
}

.mini-meta {
  margin-top: 4rpx;
  color: #9a8b83;
  font-size: 21rpx;
}

.batch-row {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 18rpx;
}

.batch-button,
.batch-quick button,
.batch-actions button,
.panel-grid button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: auto;
  border: 1rpx solid #daccc4;
  border-radius: 999rpx;
  background: #fffaf6;
  color: #5f514a;
  line-height: 1;
  margin: 0;
}

.batch-button {
  min-width: 128rpx;
  height: 48rpx;
  padding: 0 12rpx;
  font-size: 22rpx;
}

.batch-toolbar {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  background: rgba(255, 252, 248, 0.86);
}

.batch-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.selected-count {
  color: #8b3f37;
  font-size: 24rpx;
  font-weight: 700;
}

.batch-quick,
.batch-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 10rpx;
}

.batch-quick {
  margin-top: 14rpx;
}

.batch-actions {
  margin-top: 10rpx;
}

.batch-quick button,
.batch-actions button {
  min-width: 92rpx;
  height: 46rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
}

.batch-actions button.danger {
  border-color: #c05f55;
  color: #c05f55;
}

.item-card.selectable {
  border-color: #e8ded6;
  border-radius: 12rpx;
  padding: 6rpx;
  background: rgba(255, 252, 248, 0.72);
}

.item-card.selected {
  border-color: #241f1d;
  background: #f0e5df;
}

.select-mark {
  position: absolute;
  z-index: 2;
}

.select-mark {
  top: 10rpx;
  right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #ffffff;
  border-radius: 999rpx;
  background: rgba(36, 31, 29, 0.32);
  color: #ffffff;
  font-size: 22rpx;
}

.select-mark.active {
  background: #241f1d;
}


.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  background: rgba(36, 31, 29, 0.35);
}

.batch-panel {
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 24rpx 40rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #fffaf6;
}

.panel-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
}

.panel-grid button {
  min-width: 104rpx;
  max-width: 220rpx;
  height: 50rpx;
  padding: 0 20rpx;
  font-size: 23rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.batch-button::after,
.batch-quick button::after,
.batch-actions button::after,
.panel-grid button::after {
  border: 0;
}
