.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 6rpx;
}

.eyebrow {
  color: #8b3f37;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.title {
  margin-top: 12rpx;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.08;
}

.subtitle {
  margin-top: 10rpx;
  color: #9a8b83;
  font-size: 26rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 126rpx;
  height: 56rpx;
  border: 1rpx solid #2a2421;
  border-radius: 999rpx;
  background: #2a2421;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  margin: 10rpx 0 0;
  padding: 0;
}

.add-btn::after,
.category-pill::after,
.category-toggle::after {
  border: 0;
}

.overview {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 32rpx;
}

.overview-item {
  padding: 20rpx 18rpx;
  background: rgba(255, 252, 248, 0.72);
}

.overview-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.overview-label {
  display: block;
  margin-top: 6rpx;
  color: #9a8b83;
  font-size: 22rpx;
}

.search-row {
  margin-top: 28rpx;
}

.search-input {
  height: 82rpx;
  border: 1rpx solid #e8ded6;
  border-radius: 10rpx;
  background: rgba(255, 252, 248, 0.9);
  padding: 0 26rpx;
  font-size: 28rpx;
}

.category-filter {
  margin-top: 24rpx;
}

.category-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 100%;
}

.category-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 calc(50% - 6rpx);
  width: calc(50% - 6rpx);
  max-width: calc(50% - 6rpx);
  min-width: 0;
  height: 60rpx;
  box-sizing: border-box;
  border: 1rpx solid #daccc4;
  border-radius: 999rpx;
  background: transparent;
  color: #5f514a;
  font-size: 24rpx;
  font-weight: 500;
  margin: 0 0 12rpx;
  padding: 0 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-pill.active {
  background: #241f1d;
  color: #ffffff;
  border-color: #241f1d;
}

.category-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48%;
  height: 54rpx;
  border: 1rpx solid #e8ded6;
  border-radius: 999rpx;
  background: rgba(255, 252, 248, 0.7);
  color: #8b3f37;
  font-size: 23rpx;
  line-height: 1;
  margin: 12rpx auto 0;
  padding: 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx 18rpx;
}

.item-card {
  overflow: hidden;
  border-color: transparent;
  background: transparent;
}

.image-wrap {
  width: 100%;
  aspect-ratio: 1 / 1.24;
  background: #efe3dc;
  border-radius: 10rpx;
  overflow: hidden;
}

.item-image,
.image-placeholder {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9a8b83;
  font-size: 26rpx;
}

.item-body {
  padding: 16rpx 4rpx 0;
}

.item-name {
  font-size: 29rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  color: #9a8b83;
  font-size: 24rpx;
}

.empty {
  margin-top: 36rpx;
  padding: 48rpx 28rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 10rpx;
  color: #8b7d75;
  font-size: 26rpx;
}

.empty-button {
  margin-top: 28rpx;
}
