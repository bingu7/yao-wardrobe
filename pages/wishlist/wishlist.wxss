.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 6rpx;
}

.eyebrow {
  color: #8b3f37;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.title {
  margin-top: 12rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.1;
}

.subtitle {
  margin-top: 8rpx;
  color: #9a8b83;
  font-size: 26rpx;
  line-height: 1.5;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 132rpx;
  height: 58rpx;
  border: 1rpx solid #2a2421;
  border-radius: 999rpx;
  background: #2a2421;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 1;
  margin: 8rpx 0 0;
  padding: 0;
}

.add-btn::after,
.filter-pill::after,
.filter-toggle::after {
  border: 0;
}

.search-row {
  margin-top: 24rpx;
}

.search-input {
  height: 82rpx;
  border: 1rpx solid #e8ded6;
  border-radius: 10rpx;
  background: rgba(255, 252, 248, 0.9);
  padding: 0 26rpx;
  font-size: 28rpx;
}

.filter-wrap {
  margin-top: 22rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 100%;
}

.filter-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 calc(50% - 6rpx);
  width: calc(50% - 6rpx);
  max-width: calc(50% - 6rpx);
  min-width: 0;
  height: 60rpx;
  box-sizing: border-box;
  border: 1rpx solid #daccc4;
  border-radius: 999rpx;
  background: transparent;
  color: #5f514a;
  font-size: 24rpx;
  line-height: 1;
  margin: 0 0 12rpx;
  padding: 0 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-pill.active {
  background: #241f1d;
  color: #ffffff;
  border-color: #241f1d;
}

.filter-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48%;
  height: 54rpx;
  border: 1rpx solid #e8ded6;
  border-radius: 999rpx;
  background: rgba(255, 252, 248, 0.7);
  color: #8b3f37;
  font-size: 23rpx;
  line-height: 1;
  margin: 12rpx auto 0;
  padding: 0;
}

.wish-card {
  display: grid;
  grid-template-columns: 190rpx 1fr;
  gap: 22rpx;
  padding: 0;
  margin-bottom: 24rpx;
  overflow: hidden;
  background: rgba(255, 252, 248, 0.82);
}

.wish-image {
  width: 190rpx;
  height: 220rpx;
  border-radius: 0;
  background: #efe3dc;
  overflow: hidden;
}

.wish-image image,
.wish-placeholder {
  width: 100%;
  height: 100%;
}

.wish-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9a8b83;
  font-size: 24rpx;
  text-align: center;
}

.wish-info {
  padding: 20rpx 20rpx 18rpx 0;
}

.wish-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.wish-name {
  font-size: 31rpx;
  font-weight: 700;
}

.wish-price {
  color: #8b3f37;
  font-size: 30rpx;
  font-weight: 700;
}

.match-text,
.wish-note {
  margin-top: 12rpx;
  color: #5f514a;
  font-size: 24rpx;
  line-height: 1.4;
}

.delete-mini {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 48rpx;
  border: 1rpx solid #8b3f37;
  border-radius: 999rpx;
  background: transparent;
  color: #8b3f37;
  font-size: 24rpx;
  line-height: 1;
  margin-top: 16rpx;
  margin-left: 0;
  padding: 0;
}

.empty {
  padding: 44rpx 28rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 10rpx;
  color: #8b7d75;
  font-size: 26rpx;
}

.empty-button {
  margin-top: 28rpx;
}
