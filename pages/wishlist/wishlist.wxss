.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 6rpx;
}

.eyebrow {
  color: #8b3f37;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.title {
  margin-top: 12rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.1;
}

.subtitle {
  margin-top: 8rpx;
  color: #9a8b83;
  font-size: 26rpx;
  line-height: 1.5;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 124rpx;
  max-width: 124rpx;
  height: 52rpx;
  border: 1rpx solid #2a2421;
  border-radius: 999rpx;
  background: #2a2421;
  color: #ffffff;
  font-size: 23rpx;
  line-height: 1;
  margin: 8rpx 0 0;
  padding: 0;
}

.add-btn::after,
.filter-pill::after,
.filter-toggle::after {
  border: 0;
}

.search-row {
  margin-top: 24rpx;
}

.search-input {
  height: 82rpx;
  border: 1rpx solid #e8ded6;
  border-radius: 10rpx;
  background: rgba(255, 252, 248, 0.9);
  padding: 0 26rpx;
  font-size: 28rpx;
}

.filter-wrap {
  margin-top: 22rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 10rpx;
  width: 100%;
}

.filter-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: auto;
  max-width: 220rpx;
  min-width: 88rpx;
  height: 52rpx;
  box-sizing: border-box;
  border: 1rpx solid #daccc4;
  border-radius: 999rpx;
  background: transparent;
  color: #5f514a;
  font-size: 23rpx;
  line-height: 1;
  margin: 0 0 2rpx;
  padding: 0 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-pill.active {
  background: #241f1d;
  color: #ffffff;
  border-color: #241f1d;
}

.filter-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 132rpx;
  height: 48rpx;
  border: 1rpx solid #e8ded6;
  border-radius: 999rpx;
  background: rgba(255, 252, 248, 0.7);
  color: #8b3f37;
  font-size: 22rpx;
  line-height: 1;
  margin: 10rpx 0 0;
  padding: 0 20rpx;
}

.wish-card {
  display: grid;
  grid-template-columns: 166rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 0;
  margin-bottom: 24rpx;
  overflow: hidden;
  background: rgba(255, 252, 248, 0.82);
}

.wish-image {
  width: 166rpx;
  height: 210rpx;
  border-radius: 0;
  background: #efe3dc;
  overflow: hidden;
}

.wish-image image,
.wish-placeholder {
  width: 100%;
  height: 100%;
}

.wish-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9a8b83;
  font-size: 24rpx;
  text-align: center;
}

.wish-info {
  min-width: 0;
  padding: 18rpx 16rpx 16rpx 0;
}

.wish-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.wish-head > view {
  min-width: 0;
}

.wish-name {
  font-size: 31rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wish-price {
  flex: 0 0 auto;
  color: #8b3f37;
  font-size: 30rpx;
  font-weight: 700;
}

.match-text,
.wish-note {
  margin-top: 12rpx;
  color: #5f514a;
  font-size: 24rpx;
  line-height: 1.4;
  word-break: break-all;
}

.wish-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  align-items: center;
  width: 100%;
  gap: 8rpx;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #eadfd8;
}

.wish-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-sizing: border-box;
  min-width: 76rpx;
  width: auto;
  height: 40rpx;
  border: 1rpx solid #daccc4;
  border-radius: 999rpx;
  background: #fffaf6;
  color: #6a5b53;
  font-size: 21rpx;
  line-height: 1;
  padding: 0 16rpx;
}

.wish-action.primary {
  min-width: 92rpx;
  background: #241f1d;
  border-color: #241f1d;
  color: #ffffff;
}

.wish-action.danger {
  border-color: #caa39d;
  color: #8b3f37;
}

.empty {
  padding: 44rpx 28rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 10rpx;
  color: #8b7d75;
  font-size: 26rpx;
}

.empty-button {
  margin-top: 28rpx;
}
