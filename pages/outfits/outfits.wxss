.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 6rpx;
}

.hero > view:first-child {
  min-width: 0;
}

.hero-actions {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  margin-top: 8rpx;
}

.eyebrow {
  color: #8b3f37;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.title {
  margin-top: 12rpx;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.1;
}

.subtitle {
  margin-top: 8rpx;
  color: #6b5a52;
  font-size: 26rpx;
  line-height: 1.5;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 132rpx;
  height: 60rpx;
  border: 1rpx solid #2a2421;
  border-radius: 999rpx;
  background: #2a2421;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1;
  margin: 0;
  padding: 0 22rpx;
}

.plan-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 56rpx;
  border: 1rpx solid #d7c8bf;
  border-radius: 999rpx;
  background: rgba(255, 252, 248, 0.84);
  color: #5f514a;
  font-size: 22rpx;
  line-height: 1;
  padding: 0 18rpx;
}

.search-row {
  margin-top: 24rpx;
}

.search-input {
  height: 82rpx;
  border: 1rpx solid #e8ded6;
  border-radius: 10rpx;
  background: rgba(255, 252, 248, 0.9);
  padding: 0 26rpx;
  font-size: 28rpx;
}

.filter-wrap {
  margin-top: 22rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 12rpx;
  width: 100%;
}

.filter-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 104rpx;
  max-width: 220rpx;
  height: 58rpx;
  box-sizing: border-box;
  border: 1rpx solid #daccc4;
  border-radius: 999rpx;
  background: transparent;
  color: #5f514a;
  font-size: 23rpx;
  line-height: 1;
  margin: 0;
  padding: 0 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-pill.active {
  background: #241f1d;
  color: #ffffff;
  border-color: #241f1d;
}

.filter-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 50rpx;
  border: 1rpx solid #e8ded6;
  border-radius: 999rpx;
  background: rgba(255, 252, 248, 0.7);
  color: #8b3f37;
  font-size: 21rpx;
  line-height: 1;
  margin: 12rpx 0 0 auto;
  padding: 0;
}

.outfit-card {
  padding: 20rpx;
  margin-bottom: 18rpx;
  background: rgba(255, 252, 248, 0.82);
}

.outfit-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.outfit-head > view {
  min-width: 0;
}

.outfit-name {
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.outfit-warning {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  background: #fff1e8;
  color: #8b3f37;
  font-size: 24rpx;
  line-height: 1.4;
}

.piece-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.piece {
  flex: 0 0 110rpx;
}

.piece-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 10rpx;
  background: #efe3dc;
  overflow: hidden;
}

.piece-image image,
.piece-placeholder {
  width: 100%;
  height: 100%;
}

.piece-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b5a52;
  font-size: 20rpx;
  text-align: center;
}

.piece-name {
  margin-top: 8rpx;
  color: #5f514a;
  font-size: 20rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.outfit-note {
  margin-top: 18rpx;
  color: #5f514a;
  font-size: 26rpx;
  line-height: 1.5;
}

.outfit-actions {
  display: grid;
  grid-template-columns: 1fr 1.12fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eee3dc;
}

.copy-mini,
.edit-mini,
.delete-mini {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 58rpx;
  border: 1rpx solid #d9c8bd;
  border-radius: 999rpx;
  background: transparent;
  color: #5f514a;
  font-size: 22rpx;
  line-height: 1;
  margin: 0;
  padding: 0;
}

.edit-mini {
  border-color: #2d2522;
  background: #2d2522;
  color: #ffffff;
  font-weight: 600;
}

.delete-mini {
  border-color: transparent;
  background: #fbf1ed;
  color: #8b3f37;
}

.empty {
  padding: 44rpx 28rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 10rpx;
  color: #6b5a52;
  font-size: 26rpx;
}

.empty-button {
  margin-top: 28rpx;
}
