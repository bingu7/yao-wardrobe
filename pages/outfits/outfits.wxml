<view class="page">
  <view class="hero">
    <view>
      <view class="eyebrow">LOOKBOOK</view>
      <view class="title">穿搭组合</view>
      <view class="subtitle">直接查看已保存穿搭，也可以按场合快速筛选</view>
    </view>
    <view class="add-btn" role="button" aria-label="添加穿搭" bindtap="goAdd">＋ 添加</view>
  </view>

  <view class="search-row">
    <input class="search-input" placeholder="搜索穿搭名、备注或衣物" value="{{keyword}}" bindinput="onSearch" />
  </view>

  <view class="filter-wrap">
    <view class="filter-row">
      <view
        wx:for="{{visibleOccasionFilters}}"
        wx:key="*this"
        class="filter-pill {{activeOccasion === item ? 'active' : ''}}"
        role="button"
        data-occasion="{{item}}"
        bindtap="setOccasion"
        aria-label="按{{item}}筛选"
      >
        {{item}}
      </view>
    </view>
    <view wx:if="{{canToggleOccasions}}" class="filter-toggle" role="button" bindtap="toggleOccasions">{{occasionToggleText}}</view>
  </view>

  <view wx:if="{{filteredOutfits.length}}" class="section">
    <view wx:for="{{filteredOutfits}}" wx:key="id" class="outfit-card card" aria-label="穿搭{{item.name}}">
      <view class="outfit-head">
        <view>
          <view class="outfit-name">{{item.name}}</view>
          <view class="muted">{{item.occasion || '未设置场合'}}</view>
        </view>
      </view>
      <view wx:if="{{item.invalidPieceCount}}" class="outfit-warning">有 {{item.invalidPieceCount}} 件衣物已失效，请编辑后重新选择</view>
      <view class="piece-grid">
        <view wx:for="{{item.pieces}}" wx:key="itemId" class="piece">
          <view class="piece-image">
            <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" data-id="{{item.itemId}}" data-image-url="{{item.imageUrl}}" binderror="onImageError" />
            <view wx:else class="piece-placeholder">{{item.category}}</view>
          </view>
          <view class="piece-name">{{item.name}}</view>
        </view>
      </view>
      <view wx:if="{{item.note}}" class="outfit-note">{{item.note}}</view>
      <view class="outfit-actions">
        <view class="copy-mini" role="button" aria-label="复制{{item.name}}" data-id="{{item.id}}" bindtap="copyOutfit">复制</view>
        <view class="edit-mini" role="button" aria-label="编辑{{item.name}}" data-id="{{item.id}}" bindtap="editOutfit">编辑</view>
        <view class="delete-mini" role="button" aria-label="删除{{item.name}}" data-id="{{item.id}}" bindtap="deleteOutfit">删除</view>
      </view>
    </view>
  </view>

  <view wx:else class="empty card section">
    <view wx:if="{{isFiltering}}">
      <view class="empty-title">没有匹配结果</view>
      <view class="empty-text">换个关键词或场合试试。</view>
      <button class="primary-button empty-button" bindtap="clearFilters">清除筛选</button>
    </view>
    <view wx:else>
      <view class="empty-title">还没有穿搭</view>
      <view class="empty-text">把常用组合保存下来，之后可以直接查看。</view>
      <button class="primary-button empty-button" bindtap="goAdd">添加穿搭</button>
    </view>
  </view>
</view>
