<view class="page">
  <view class="form-head">
    <button class="back-button" bindtap="goBack">返回</button>
    <view>
      <view class="title">添加愿望</view>
      <view class="subtitle">想买之前先记下来，看看能不能搭上已有衣物</view>
    </view>
  </view>

  <view class="wish-form card section">
    <view class="upload" bindtap="chooseImage">
      <image wx:if="{{form.imageUrl}}" class="upload-image" src="{{form.imageUrl}}" mode="aspectFill" />
      <button wx:if="{{form.imageUrl}}" class="remove-image" catchtap="removeImage">移除</button>
      <view wx:else class="upload-empty">
        <view class="upload-plus">+</view>
        <view class="muted">添加参考图片</view>
      </view>
    </view>

    <view class="field">
      <text class="label">名字</text>
      <input class="input" placeholder="例如：黑色玛丽珍鞋" value="{{form.name}}" data-field="name" bindinput="onInput" maxlength="24" />
    </view>

    <view class="field">
      <text class="label">种类</text>
      <view class="picker-value category-trigger" bindtap="openCategoryPanel">
        <text>{{form.category || '选择种类'}}</text>
        <text class="trigger-arrow">›</text>
      </view>
    </view>

    <view class="field">
      <text class="label">预计价格</text>
      <input class="input" type="digit" placeholder="单位元，可不填" value="{{form.expectedPrice}}" data-field="expectedPrice" bindinput="onInput" />
    </view>

    <view class="field">
      <text class="label">想搭配已有衣物</text>
      <view class="picker-value category-trigger" bindtap="openMatchPanel">
        <text>{{matchLabel}}</text>
        <text class="trigger-arrow">›</text>
      </view>
    </view>

    <view class="field">
      <text class="label">备注</text>
      <textarea class="textarea" placeholder="为什么想买、适合什么场合、是否容易重复" value="{{form.note}}" data-field="note" bindinput="onInput" />
    </view>
  </view>

  <button class="primary-button save-button" bindtap="saveWish">保存愿望</button>

  <view wx:if="{{showCategoryPanel}}" class="panel-mask" catchtap="closeCategoryPanel">
    <view class="category-panel" catchtap="noop">
      <view class="panel-head">
        <view class="panel-actions">
          <button class="panel-action" bindtap="toggleCategoryEditing">{{isCategoryEditing ? '完成' : '编辑'}}</button>
          <button class="panel-close" bindtap="closeCategoryPanel">关闭</button>
        </view>
      </view>

      <view wx:if="{{!isCategoryEditing}}" class="category-grid">
        <view
          wx:for="{{categoryPanelItems}}"
          wx:key="name"
          class="category-chip {{item.selected ? 'selected' : ''}}"
          data-category="{{item.name}}"
          bindtap="selectCategoryFromPanel"
          bindlongpress="startCategoryEditing"
        >
          {{item.name}}
        </view>
      </view>

      <view wx:else class="category-edit-list">
        <view wx:for="{{categoryPanelItems}}" wx:key="name" class="category-edit-card">
          <button class="delete-x" data-category="{{item.name}}" catchtap="deleteCustomCategory">×</button>
          <input
            class="category-edit-input"
            value="{{item.draftName}}"
            data-index="{{index}}"
            bindinput="onCategoryDraftInput"
            maxlength="10"
          />
          <view class="category-card-actions">
            <button class="mini-button save-mini" data-index="{{index}}" bindtap="renameCategoryFromPanel">保存</button>
            <button class="mini-button" disabled="{{!item.canMoveUp}}" data-category="{{item.name}}" data-direction="-1" bindtap="moveCategoryFromPanel">上移</button>
            <button class="mini-button" disabled="{{!item.canMoveDown}}" data-category="{{item.name}}" data-direction="1" bindtap="moveCategoryFromPanel">下移</button>
          </view>
        </view>
      </view>

      <view class="panel-add">
        <input class="custom-input" placeholder="没有合适的？输入新种类" value="{{customCategory}}" bindinput="onCustomCategoryInput" maxlength="10" />
        <button class="custom-button" bindtap="addCustomCategory">添加</button>
      </view>
    </view>
  </view>

  <!-- 搭配衣物面板（简单选择，无编辑） -->
  <view wx:if="{{showMatchPanel}}" class="panel-mask" catchtap="closeMatchPanel">
    <view class="category-panel" catchtap="noop">
      <view class="panel-head">
        <view class="panel-actions">
          <button class="panel-close" bindtap="closeMatchPanel">关闭</button>
        </view>
      </view>
      <view class="match-list">
        <view
          wx:for="{{matchOptions}}"
          wx:key="id"
          class="match-row {{item.id === form.matchItemId ? 'selected' : ''}}"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="selectMatchItem"
        >
          <view class="match-name">{{item.name}}</view>
          <view wx:if="{{item.category}}" class="match-category">{{item.category}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
