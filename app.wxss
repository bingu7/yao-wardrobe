page {
  min-height: 100vh;
  background: #f8f5f1;
  color: #241f1d;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 56rpx 30rpx 34rpx;
  padding-bottom: 140rpx;
}

.section {
  margin-top: 28rpx;
}

.card {
  border: 1rpx solid #e8ded6;
  border-radius: 10rpx;
  background: rgba(255, 252, 248, 0.88);
}

.muted {
  color: #9a8b83;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 10rpx;
  background: #241f1d;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  padding: 0;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border: 1rpx solid #d7c8bf;
  border-radius: 10rpx;
  background: rgba(255, 252, 248, 0.84);
  color: #241f1d;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
  padding: 0;
}

button::after {
  border: 0;
}
